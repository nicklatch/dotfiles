{
    "$schema": "https://opencode.ai/config.json",
    "theme": "system",
    "autoupdate": true,
    "tui": {
        "scroll_acceleration": {
            "enabled": true
        }
    },
    "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "list": true,
        "webfetch": true,
    },
    "permission": {
        "sudo *": "deny",
        "rm -rf /": "deny",
        "rm -rf /*": "deny",
        "rm -rf ~": "deny",
        "rm -rf ~/*": "deny",
        ":(){:|:&};:": "deny",
        "bd *": "allow",
        "lsp": "allow",
        "todoread": "allow",
        "skill": "allow",
        "websearch": "allow",
        "question": "allow"
    },
    "lsp": {
        "devsense-php-ls": {
            "disabled": false,
            "command": [
                "devsense-php-ls",
                "--stdio"
            ],
            "extensions": [
                ".php",
            ],
            "initialization": {
                "0": "{env:DEVSENSE_PHP_LS_LICENSE}"
            },
        }
    },
    "mcp": {
        "context7": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@upstash/context7-mcp",
                "--api-key",
                "{env:CONTEXT7_KEY}"
            ],
            "enabled": true
        },
        "playwright": {
            "type": "local",
            "command": [
                "npx",
                "@playwright/mcp@latest"
            ],
            "enabled": true
        },
        "chrome-devtools": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "chrome-devtools-mcp@latest"
            ]
        },
    },
    "agent": {
        "build": {
            "model": "openai/gpt-5.3-codex",
            "temperature": 0.1
        },
        "plan": {
            "model": "openai/gpt-5.3-codex",
            "temperature": 0.1,
            "tools": {
                "write": false,
                "edit": false,
                "patch": false,
                "sed": false,
                "cat": false,
                "read": true,
                "grep": true,
                "glob": true,
                "list": true,
                "webfetch": true,
            },
            "permission": {
                "external_directory": "allow",
                "bash": {
                    "git status": "allow",
                    "git diff*": "allow",
                    "git log*": "allow",
                    "git show*": "allow",
                    "bd *": "allow",
                    "rg *": "allow",
                    "tree *": "allow",
                    "wc *": "allow",
                    "head *": "allow",
                    "tail *": "allow",
                },
                "todowrite": "allow"
            },
        },
    },
    "plugin": [
        "@tarquinen/opencode-dcp@latest",
        "opencode-pty",
        "@mohak34/opencode-notifier@latest",
        "@franlol/opencode-md-table-formatter@0.0.3",
        "opencode-beads",
        "@plannotator/opencode@latest",
        "octto"
    ]
}
